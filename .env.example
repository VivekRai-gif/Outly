# ==============================================================================
# OUTLY SaaS OUTREACH ENGINE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ==================== OTHER ====================
# Application Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=production
# Backend Server HTTP Port
PORT=5000
# Base public URL of the Backend API Server (used for email open & click tracking pixel URL generation)
SERVER_URL=https://your-outly-backend.onrender.com

# ==================== DATABASE ====================
# MongoDB Atlas Connection URI String (SSL/TLS required for Atlas production cluster)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/outly?retryWrites=true&w=majority

# ==================== EMAIL / GMAIL ====================
# Google OAuth 2.0 Client ID (From Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Google OAuth 2.0 Client Secret (From Google Cloud Console Credentials)
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Authorized OAuth Redirect URI (Must match Google Cloud Console Authorized Redirect URIs exactly)
GOOGLE_REDIRECT_URI=https://your-outly-backend.onrender.com/api/auth/google/callback

# ==================== REDIS / QUEUE ====================
# Redis Server Hostname (Upstash, AWS ElastiCache, or Managed Redis)
REDIS_HOST=your-redis-instance.upstash.io
# Redis Server Port
REDIS_PORT=6379
# Redis Server Password (Leave blank if unauthenticated in local dev)
REDIS_PASSWORD=your_redis_password

# ==================== FRONTEND ====================
# Base public URL of the Frontend Single Page Application (Used for CORS origin validation & OAuth redirects)
CLIENT_URL=https://your-outly-frontend.vercel.app
# Public API Endpoint for Vite Frontend SPA Client Requests
VITE_API_URL=https://your-outly-backend.onrender.com/api

# ==================== SECURITY ====================
# Security middleware (Helmet HTTP headers, Rate Limiting, MongoSanitize, CORS rules) is pre-configured via app.js and security.middleware.js using CLIENT_URL and NODE_ENV.

# ==================== STORAGE ====================
# PDF uploads are temporarily buffered to backend storage directory ('uploads/') and automatically deleted after contact extraction.

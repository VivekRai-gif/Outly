# ==============================================================================
# OUTLY BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ==================== OTHER ====================
# Application Runtime Environment
NODE_ENV=production
# Backend Server HTTP Port
PORT=5000
# Base public URL of the Backend API Server (used for open & click tracking pixels)
SERVER_URL=https://outly-backend-pdac.onrender.com

# ==================== DATABASE ====================
# MongoDB Atlas Connection URI String
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/outly?retryWrites=true&w=majority

# ==================== EMAIL / GMAIL ====================
# Google OAuth 2.0 Client ID (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Google OAuth 2.0 Client Secret (From Google Cloud Console)
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Authorized OAuth Redirect URI
GOOGLE_REDIRECT_URI=https://outly-backend-pdac.onrender.com/api/auth/google/callback

# ==================== REDIS / QUEUE ====================
# Redis Server Hostname (Upstash, AWS ElastiCache, or Managed Redis)
REDIS_HOST=your-redis-instance.upstash.io
# Redis Server Port
REDIS_PORT=6379
# Redis Server Password
REDIS_PASSWORD=your_redis_password

# ==================== FRONTEND ====================
# Base public URL of the Frontend Single Page Application (used for CORS and OAuth redirect)
CLIENT_URL=https://outly-five.vercel.app
